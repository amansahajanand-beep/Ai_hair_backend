          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK - generation accepted\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"success=true and image present\", () => { pm.expect(j.success).to.eql(true); pm.expect(j.image).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
