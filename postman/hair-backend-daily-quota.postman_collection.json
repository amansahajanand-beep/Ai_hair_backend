              ],
              "path": [
                "api",
                "hairstyle"
              ]
            }
          }
        },
        {
          "name": "7. Check quota (remaining 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"remaining = 0\", () => pm.expect(d.remaining).to.eql(0));",
                  "pm.test(\"image_generation = false\", () => pm.expect(d.image_generation).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\"\n}"
            },
            "url": {
