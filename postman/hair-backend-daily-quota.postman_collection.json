              ]
            }
          }
        },
        {
          "name": "6. Generate #4 -> 429 quota exceeded",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"429 quota exceeded\", () => pm.response.to.have.status(429));",
                  "const j = pm.response.json();",
                  "pm.test(\"code DAILY_QUOTA_EXCEEDED\", () => { pm.expect(j.success).to.eql(false); pm.expect(j.code).to.eql(\"DAILY_QUOTA_EXCEEDED\"); pm.expect(j.remaining).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "device_id",
                  "value": "{{device_id}}",
                  "type": "text"
                },
                {
                  "key": "hair_style",
                  "value": "LowFade",
                  "type": "text"
                },
                {
                  "key": "color",
                  "value": "blonde",
                  "type": "text"
                }
              ]
            },
            "url": {
