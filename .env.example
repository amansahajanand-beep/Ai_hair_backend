# Server Configuration
PORT=3000
NODE_ENV=development

# hairApi
DEBUG=true

# hairstyle-api
API_KEY=your_ailab_api_key_here

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hair-backend

# true = skip AILab (quota test only) | false = real generation
MOCK_GENERATION=true

# Daily generation quota per device_id (hair/beard generation requests).
# Positive integer. Default: 3 if unset. Restart the app after changing.
DAILY_API_QUOTA=3

# IANA timezone that decides when the quota day resets (midnight in this zone).
# Default: UTC. Example: Asia/Kolkata
QUOTA_TIMEZONE=UTC

# Admin dashboard (/admin). Leave ADMIN_PASSWORD empty to disable it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (sessions end on restart if unset)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
